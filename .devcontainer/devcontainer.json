// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-outside-of-docker
{
	"name": "Docker in Docker",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// NVIDIA CUDA devel image (not the devcontainers/base + nvidia-cuda feature combo): that
	// feature tops out at CUDA 12.5, which is too old for flashinfer's nvcc flags when vLLM's
	// torch build targets newer CUDA. Bump this tag in lockstep with whatever CUDA version
	// `uv tool install vllm` pulls torch for.
	"image": "nvidia/cuda:13.0.3-devel-ubuntu24.04",

	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"moby": "true"
		},
		"ghcr.io/devcontainers-extra/features/uv:1": {},
		"./features/llama-cpp": {},
		"./features/docker-config": {},
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": "tmux python3.12-dev ninja-build jsonnet"
		}
	},

	"remoteUser": "vscode",

	// Use this environment variable if you need to bind mount your local source code into a new container.
	"remoteEnv": {
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
	},

	"containerEnv": {
		"CUDA_VISIBLE_DEVICES": "6,7"
	},

	"runArgs": ["--ipc=host", "--gpus", "all", "-p", "8085:8085"],

	"mounts": [
		{
			"type": "bind",
			"source": "/dev/shm",
			"target": "/dev/shm"
		},
		{
			"type": "volume",
			"source": "auto-bench-config",
			"target": "/home/vscode/.config"
		},
		{
			"type": "volume",
			"source": "auto-bench-cache",
			"target": "/home/vscode/.cache"
		}
	],
	"postCreateCommand": "mkdir -p /home/vscode/.config /home/vscode/.cache && sudo chown -R vscode:vscode /home/vscode/.config /home/vscode/.cache && uv tool install --editable /workspaces/auto-bench && uv tool install vllm",
	// This forwards to the local machine, which could be useful for debugging?
	"forwardPorts": [8085],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "docker --version",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
